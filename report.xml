  <database-schema>
    <extension>uuid-ossp</extension>
    <tables>
      <table name="users">
        <columns>
          <column name="user_id" type="UUID" primary-key="true" default="uuid_generate_v4()"/>
          <column name="name" type="TEXT" nullable="false"/>
          <column name="email" type="TEXT" nullable="false" unique="true"/>
          <column name="registration_date" type="DATE" nullable="false"/>
          <column name="role" type="TEXT" default="'user'"/>
          <column name="created_at" type="TIMESTAMP WITH TIME ZONE" default="now()"/>
        </columns>
      </table>
      
      <table name="habit_templates">
        <columns>
          <column name="habit_id" type="UUID" primary-key="true" default="uuid_generate_v4()"/>
          <column name="name" type="TEXT" nullable="false"/>
          <column name="description" type="TEXT"/>
          <column name="category" type="TEXT"/>
          <column name="frequency" type="TEXT"/>
          <column name="reminder_time" type="TIME"/>
          <column name="created_at" type="TIMESTAMP WITH TIME ZONE" default="now()"/>
        </columns>
      </table>
      
      <table name="habit_log">
        <columns>
          <column name="user_id" type="UUID" nullable="false"/>
          <column name="habit_id" type="UUID" nullable="false"/>
          <column name="log_date" type="DATE" nullable="false"/>
          <column name="is_completed" type="BOOLEAN" nullable="false" default="FALSE"/>
          <column name="completion_time" type="TIME"/>
          <column name="notes" type="TEXT"/>
          <column name="created_at" type="TIMESTAMP WITH TIME ZONE" default="now()"/>
        </columns>
        <primary-key>user_id, habit_id, log_date</primary-key>
        <foreign-keys>
          <foreign-key column="user_id" references="users(user_id)" on-delete="CASCADE"/>
          <foreign-key column="habit_id" references="habit_templates(habit_id)" on-delete="CASCADE"/>
        </foreign-keys>
      </table>
    </tables>
  </database-schema>

