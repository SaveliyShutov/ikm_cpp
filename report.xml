  <architecture-overview>
    <pattern>Model-View-ViewModel (MVVM) с элементами MVC</pattern>
    <layers>
      <layer name="Data Layer">
        <components>DatabaseManager, PostgreSQL</components>
        <responsibility>Управление данными, работа с базой данных</responsibility>
      </layer>
      <layer name="Business Logic Layer">
        <components>HabitsModel, LogsModel, UsersModel, SqlQueryModel</components>
        <responsibility>Обработка бизнес-логики, CRUD операции, предоставление данных ViewModel</responsibility>
      </layer>
      <layer name="Presentation Layer">
        <components>QML (main.qml), Qt Quick Controls</components>
        <responsibility>Пользовательский интерфейс, отображение данных</responsibility>
      </layer>
    </layers>
    <data-flow>
      <flow-direction>QML → Модели → DatabaseManager → PostgreSQL → DatabaseManager → Модели → QML</flow-direction>
      <communication-methods>Q_INVOKABLE методы, context properties, сигналы/слоты</communication-methods>
    </data-flow>
  </architecture-overview>

